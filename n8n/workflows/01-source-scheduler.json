    },
    {
      "parameters": {
        "jsCode": "// Selects the sources that are due to run.\n//\n// The whole due-source decision lives here, in n8n — the database stores\n// next_run_at and priority but never acts on them.\n//\n// The sources table is small (dozens of rows), so it is fetched whole and\n// filtered in memory rather than expressed as an OR query.\n\nconst all = $input.all().map(i => i.json);\n\n// Settings rows and source rows arrive merged; separate them by shape.\nconst settingsRows = all.filter(r => typeof r.key === 'string' && 'value' in r);\nconst sources = all.filter(r => typeof r.base_url === 'string');\n\nconst setting = (key, fallback) => {\n  const row = settingsRows.find(r => r.key === key);\n  return row && row.value !== null && row.value !== undefined ? row.value : fallback;\n};\n\n// Non-critical setting: a missing interval map falls back to the documented\n// defaults rather than halting ingestion.\nconst intervals = setting('ingestion.priority_intervals', {\n  '1': 60, '2': 180, '3': 360, '4': 720, '5': 1440,\n});\n\nconst now = Date.now();\nconst due = [];\n\nfor (const s of sources) {\n  // Belt and braces: the DB constraint already forbids an active source that\n  // is not verified, but never crawl on the strength of one check.\n  if (!s.active || s.config_status !== 'verified') continue;\n  if (s.parser_type === 'unknown') continue;\n\n  // A source in retry backoff waits until its next_retry_at passes (M10).\n  if (s.next_retry_at && new Date(s.next_retry_at).getTime() > now) continue;\n\n  const intervalMinutes = s.poll_interval_minutes\n    ?? Number(intervals[String(s.priority)] ?? 360);\n\n  const nextRun = s.next_run_at ? new Date(s.next_run_at).getTime() : 0;\n  if (nextRun > now) continue;\n\n  due.push({\n    json: {\n      source: s,\n      interval_minutes: intervalMinutes,\n      trigger_type: 'scheduled',\n      dispatched_at: new Date(now).toISOString(),\n    },\n  });\n}\n\nreturn due;"
      },
