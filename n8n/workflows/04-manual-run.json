    {
      "parameters": {
        "jsCode": "// Same eligibility the old scheduler enforced — a manual refresh cannot run\n// a source the database itself would refuse to activate. Discovery-mode\n// sources are excluded here on purpose: Workflow 05 resolves and dispatches\n// them on its own, via the separate call below.\nconst runId = $('Insert running run').first().json.id;\nconst win = $('Compute window & guard').first().json;\nconst all = $input.all().map((i) => i.json).filter((r) => typeof r.base_url === 'string');\n\nconst eligible = all.filter((s) =>\n  s.active && s.config_status === 'verified' && s.parser_type !== 'unknown' && s.ingestion_mode !== 'discovery'\n);\n\nreturn eligible.map((s) => ({ json: {\n  source: s,\n  trigger_type: 'manual',\n  dispatched_at: new Date().toISOString(),\n  correlation_id: `catchup-${runId}-${s.id}`,\n  requested_by: win.requested_by,\n  window_from: win.window_from,\n  window_to: win.window_to,\n}}));"
      },
