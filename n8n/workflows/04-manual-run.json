    {
      "parameters": {
        "jsCode": "// ── FINALISE THE CATCH-UP RUN ───────────────────────────────────────────────\n// Aggregates items_published across every per-source summary Workflow 02\n// returned (official dispatch) and every group Workflow 05's own call into\n// 02 returned (discovery). A per-source fetch failure is already isolated\n// and retried inside 02/03 — it does not fail the WHOLE run here. Only a\n// dispatch that could not even START (the Execute Workflow node itself\n// erroring, e.g. Workflow 02/05 broken) counts as a run failure — that is\n// the case where this refresh cannot claim to have covered everything it\n// was supposed to, and per migration 0024, a failed run never advances the\n// checkpoint.\n\nconst items = $input.all().map((i) => i.json);\nlet itemsInserted = 0;\nlet dispatchFailures = 0;\n\nfor (const e of items) {\n  if (e.error) { dispatchFailures += 1; continue; }\n  itemsInserted += Number(e.items_published || 0);\n}\n\nconst runId = $('Insert running run').first().json.id;\nconst totalFailure = items.length > 0 && dispatchFailures === items.length;\n\nreturn [{ json: {\n  id: runId,\n  status: totalFailure ? 'failed' : 'succeeded',\n  items_inserted: itemsInserted,\n  completed_at: new Date().toISOString(),\n  error_message: totalFailure ? `${dispatchFailures} dispatch(es) could not start` : null,\n}}];"
      },
      "id": "a293534e-fe73-4a91-ac14-d8436d9fdfc2",
      "name": "Finalize run",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        912,
        368
      ]
    },
