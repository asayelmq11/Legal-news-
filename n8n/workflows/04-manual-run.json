    {
      "parameters": {
        "jsCode": "// The catch-up refresh always covers every currently eligible source —\n// there is no scope to validate any more (the old source/country/url\n// scopes were dead code: nothing in this app ever called them). The only\n// optional input is who asked for it, for attribution.\n\nconst body = $('Manual run webhook').first().json.body || {};\nreturn [{ json: {\n  requested_by: body.requested_by || null,\n  requested_at: new Date().toISOString(),\n}}];"
      },
