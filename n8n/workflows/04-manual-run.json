    {
      "parameters": {
        "jsCode": "// A unique-violation here is the race the ingestion_runs_one_active partial\n// index exists for: two requests both passed the pre-check at once. That is\n// ANOTHER RUN ALREADY STARTING, not a failure — answered the same as the\n// ordinary already-running case, never as an error.\nconst err = $input.first().json.error || $input.first().json;\nconst message = String(err?.message ?? err?.details ?? err ?? 'insert failed');\nconst isRace = /duplicate key|ingestion_runs_one_active|23505/i.test(message);\nreturn [{ json: {\n  ok: isRace,\n  status: isRace ? 'already_running' : 'failed',\n  reason: isRace ? null : message.slice(0, 500),\n}}];"
      },
      "id": "676d2f3e-5b54-43df-a2a0-588b900f5219",
      "name": "Handle insert race or failure",
