    {
      "parameters": {
        "jsCode": "// ── CATCH-UP WINDOW + SINGLE-FLIGHT GUARD ───────────────────────────────────\n// Reads both queries this execution fired (Get running run / Get last\n// succeeded run) and decides: is a refresh already running, and if not,\n// what window this one covers.\n//\n// The checkpoint only ever advances from a SUCCEEDED row's window_to — a\n// failed or still-running row is invisible here, so a half-finished refresh\n// can never create a coverage gap (migration 0024).\n\nconst OVERLAP_HOURS = 6;\nconst INITIAL_LOOKBACK_HOURS = 24 * 7;\n\nconst all = $input.all().map((i) => i.json);\nconst running = all.filter((r) => r.status === 'running');\nconst succeeded = all.filter((r) => r.status === 'succeeded');\n\nif (running.length > 0) {\n  return [{ json: { __already_running: true, started_at: running[0].started_at || null } }];\n}\n\nconst now = new Date();\nlet windowFrom;\nif (succeeded.length > 0) {\n  const latest = succeeded.reduce((a, b) => (new Date(a.window_to) > new Date(b.window_to) ? a : b));\n  // Safety overlap: boundary-time items right at the edge of the previous\n  // window are re-fetched on purpose. Deduplication (content_hash) drops\n  // the resulting repeats — that is cheaper and safer than risking a gap.\n  windowFrom = new Date(new Date(latest.window_to).getTime() - OVERLAP_HOURS * 3600 * 1000);\n} else {\n  // No prior successful refresh at all — a bounded initial lookback, not an\n  // unlimited historical backfill.\n  windowFrom = new Date(now.getTime() - INITIAL_LOOKBACK_HOURS * 3600 * 1000);\n}\n\nconst req = $('Parse request').first().json;\n\nreturn [{ json: {\n  __already_running: false,\n  window_from: windowFrom.toISOString(),\n  window_to: now.toISOString(),\n  requested_by: req.requested_by,\n}}];"
      },
      "id": "a36b5210-bdc9-4a98-811b-d6e1d3a55921",
