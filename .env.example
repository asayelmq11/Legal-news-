# =============================================================================
# Legal Intelligence Platform — environment template
#
# Copy to .env.local and fill in. Never commit the filled file.
#
# SCOPE NOTE: this file configures the Next.js application ONLY.
# n8n holds its own credentials (Supabase service_role, AI provider key, SMTP /
# Microsoft 365) in the n8n Credentials store — they do NOT belong here, and
# they must never be added to app_settings either.
# =============================================================================

# -----------------------------------------------------------------------------
# Supabase — public client configuration
#
# Both values are safe to expose to the browser. The anon key carries no
# privilege on its own; every table is protected by Row Level Security, and the
# archive tables have no write policy or grant at all.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# -----------------------------------------------------------------------------
# n8n manual-run trigger  (plan §9 — wired up in M10)
#
# Server-side only. Deliberately NOT prefixed with NEXT_PUBLIC_, so it is never
# inlined into a client bundle. The "Run now" admin control fails closed when
# either value is missing: it is disabled with an explanation rather than
# falling back to an unauthenticated request.
#
# Generate the secret with:  openssl rand -hex 32
# -----------------------------------------------------------------------------
N8N_TRIGGER_WEBHOOK_URL=https://n8n.internal.example.com/webhook/legal-ingestion-run
N8N_TRIGGER_SECRET=

# -----------------------------------------------------------------------------
# NEVER PUT THESE HERE
#
#   SUPABASE_SERVICE_ROLE_KEY  -> n8n Credentials only. It bypasses RLS and is
#                                 the sole write path into legal_updates.
#   ANTHROPIC_API_KEY / OPENAI_API_KEY -> n8n Credentials only.
#   SMTP / Microsoft 365 secrets       -> n8n Credentials only.
#
# The web application has no code path that needs any of them. If one appears
# necessary, the design has drifted — the app is not meant to write the archive
# or call the AI provider.
# -----------------------------------------------------------------------------
