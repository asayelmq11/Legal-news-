# =============================================================================
# Legal Intelligence Platform — environment template
#
# Copy to .env.local and fill in. Never commit the filled file.
#
# SCOPE NOTE: this file configures the Next.js application ONLY.
# n8n holds its own credentials (Supabase service_role, Azure OpenAI key) in
# the n8n Credentials store — they do NOT belong here, and they must never be
# added to app_settings either.
# =============================================================================

# -----------------------------------------------------------------------------
# Supabase — public client configuration
#
# Both values are safe to expose to the browser. The anon key carries no
# privilege on its own; every table is protected by Row Level Security, and the
# archive table has no write policy or grant at all.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# -----------------------------------------------------------------------------
# NEVER PUT THESE HERE
#
#   SUPABASE_SERVICE_ROLE_KEY  -> n8n Credentials only. It bypasses RLS and is
#                                 the sole write path into legal_updates.
#   Azure OpenAI API key       -> n8n Credentials only ("Azure OpenAI account").
#
# The web application has no code path that needs either. If one appears
# necessary, the design has drifted — the app is not meant to write the archive
# or call the AI provider. There is no admin-triggered n8n webhook from the app
# either; a manual run is started directly in n8n.
# -----------------------------------------------------------------------------
